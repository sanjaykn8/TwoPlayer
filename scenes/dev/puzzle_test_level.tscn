text = "Hold the light.
Let the other pass."

[node name="ClueS3" parent="Clues" unique_id=73267225 instance=ExtResource("17_uyu35")]
position = Vector2(904, 512)
text = "Two blades.
One heartbeat."

[node name="ClueS4" parent="Clues" unique_id=611089656 instance=ExtResource("17_uyu35")]
position = Vector2(1344, 512)
text = "The door counts.
One strikes, one runs."

[node name="ClueS5" parent="Clues" unique_id=1902926732 instance=ExtResource("17_uyu35")]
position = Vector2(1736, 512)
text = "Above and below.
Two hands, one door."

[node name="ClueS6" parent="Clues" unique_id=2092385561 instance=ExtResource("17_uyu35")]
position = Vector2(2360, 512)
text = "The gate listens
to both sides."

[node name="ClueS7" parent="Clues" unique_id=1017042857 instance=ExtResource("17_uyu35")]
position = Vector2(2632, 512)
text = "The bridge walks
only when watched."

[node name="ClueS8" parent="Clues" unique_id=2082047823 instance=ExtResource("17_uyu35")]
position = Vector2(3296, 512)
text = "It hungers for one.
The other works."

[node name="ClueS9" parent="Clues" unique_id=25701172 instance=ExtResource("17_uyu35")]
