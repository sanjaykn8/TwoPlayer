# Godot 4+ specific ignores
.godot/
/android/

# Export output and temporary builds
/builds/
/exports/
/export/
*.exe
*.pck
*.tmp

# Logs
logs/
*.log

# Local save data must never live in the repository (saves go to %APPDATA%/TwoKnightCoop/)
/saves/
*.save

# Sensitive / machine-local files
.env
*.pem
*.key
*.keystore
export_credentials.cfg

# OS clutter
Thumbs.db
desktop.ini
.DS_Store
