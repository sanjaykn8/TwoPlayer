# Godot 4+ specific ignores
.godot/
/android/

# Export output and temporary builds
/builds/
/exports/
/export/
*.exe
*.pck
*.tmp

# Logs
logs/
*.log

# Local save data must never live in the repository (saves go to %APPDATA%/TwoKnightCoop/)
/saves/
*.save
# Save-slot helper files and test save folders (they live in %APPDATA%, never here)
slot_*.bak
slot_*.tmp
slot_*.dead
slot_*.corrupt
test_saves*/
saves_dev/
saves_ui_dev/
# Player preferences (they live in %APPDATA%, never here)
settings*.cfg
settings*.cfg.tmp

# Sensitive / machine-local files
.env
*.pem
*.key
*.keystore
export_credentials.cfg

# OS clutter
Thumbs.db
desktop.ini
.DS_Store
